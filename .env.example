# Use a unique strong password outside local development.
DB_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD
DB_USERNAME=sa
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=portfolio;encrypt=true;trustServerCertificate=true
FRONTEND_URL=http://localhost:4200
# Public origins accepted by the production API.
# FRONTEND_URLS=https://danielramonperez.com,https://www.danielramonperez.com
SERVER_PORT=8080
# Production keeps the backend reachable only from this PC and cloudflared.
# SERVER_ADDRESS=127.0.0.1

# Job-offer email. "log" keeps local development credential-free.
JOB_OFFER_MAIL_MODE=log
JOB_OFFER_MAIL_FROM=Portfolio de Daniel <ofertas@danielramonperez.com>
JOB_OFFER_MAIL_TO=daniel@example.com
# Set true only in local development when you intentionally want PII in logs.
JOB_OFFER_LOG_CONTENT=false

# Resend SMTP values. Keep SMTP_PASSWORD empty in this versioned example.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Basic public-endpoint protection.
JOB_OFFER_RATE_LIMIT_MAX_REQUESTS=3
JOB_OFFER_RATE_LIMIT_WINDOW=15m

# Public Message Board. Generate a long random value locally; never expose it in Angular.
MESSAGE_BOARD_ADMIN_KEY=
MESSAGE_BOARD_RATE_LIMIT_MAX_REQUESTS=5
MESSAGE_BOARD_RATE_LIMIT_WINDOW=10m
# Browser moderation sessions are signed with MESSAGE_BOARD_ADMIN_KEY.
MESSAGE_BOARD_ADMIN_SESSION_TTL=30d
MESSAGE_BOARD_ADMIN_ACTIVATION_TTL=2m
MESSAGE_BOARD_ADMIN_MAX_ATTEMPTS=8
MESSAGE_BOARD_ADMIN_ATTEMPT_WINDOW=5m
MESSAGE_BOARD_ADMIN_COOKIE_SECURE=true
